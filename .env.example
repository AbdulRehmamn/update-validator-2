# NumVerify Pro v6 live lookup configuration
#
# Copy this file to .env, add ONE provider's credentials, save, and restart.
# The browser never receives these secrets. Provider lookups can incur charges.

# Local API keys for scripts that call this server (X-API-Key header).
# Comma-separate several keys. Leave empty to keep the API open (no key needed).
# The browser portal keeps working either way.
API_KEYS=

# auto = Telnyx first, then Twilio as fallback when both are configured.
# Other values: telnyx, twilio, offline
LOOKUP_PROVIDER=auto

# Recommended for U.S./Canada carrier and portability details.
TELNYX_API_KEY=

# Twilio option A (recommended): API key SID and API key secret.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Twilio option B: Account SID and Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cache live results locally to reduce repeat charges. Set 0 to disable.
LOOKUP_CACHE_HOURS=24

# Keep concurrency within your provider's account limits.
LOOKUP_CONCURRENCY=8
LOOKUP_TIMEOUT_SECONDS=20
